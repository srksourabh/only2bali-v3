# Copy to .env.local for development. Never commit the filled-in version.

# Postgres. Local Docker, or an SSH tunnel to the VPS:
#   ssh -L 5433:127.0.0.1:5432 deploy@YOUR_VPS
#   DATABASE_URL="postgres://only2bali:PASSWORD@127.0.0.1:5433/only2bali"
DATABASE_URL=

# Set to "require" when connecting to Postgres over anything but loopback.
DATABASE_SSL=

# Server-side only. Must never reach the client.
GEMINI_API_KEY=
