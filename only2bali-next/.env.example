# Copy to .env.local for development. Never commit the filled-in version.

# --- database ---
# Production (Vercel): the VPS hostname, with mutual TLS below.
#   postgres://only2bali_app:PASSWORD@db.only2bali.com:5432/only2bali
# Local development: an SSH tunnel keeps the traffic off the internet entirely.
#   ssh -L 5433:127.0.0.1:5432 deploy@YOUR_VPS
#   postgres://only2bali_app:PASSWORD@127.0.0.1:5433/only2bali
DATABASE_URL=

# --- mutual TLS ---
# Base64-encoded PEMs, produced by infra/postgres/generate-certs.sh.
# All three or none: a partial configuration is a startup error, not a silent
# downgrade to password-only.
#
# Without these the app refuses to connect to a non-loopback host in production.
PGSSL_CA=
PGSSL_CERT=
PGSSL_KEY=

# Only used when there are no certificates and the host is loopback.
DATABASE_SSL=

# Serverless keeps many short-lived instances, so pools stay small.
DATABASE_POOL_MAX=

# --- auth ---
# Keys the OTP and session hashes. Rotating it invalidates every outstanding
# code and session, which is the intended emergency lever.
#   openssl rand -base64 48
AUTH_SECRET=

# Username/password admin bootstrap. Never expose admin registration publicly.
# Run after setting these:
#   npm run admin:create
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Google OAuth for traveler/provider login (legacy; prefer Clerk when configured).
# Authorized redirect URI:
#   https://YOUR_DOMAIN/api/auth/google/callback
# Local redirect URI:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Clerk OAuth (recommended) ---
# Create an application at https://dashboard.clerk.com
# Enable Google / Apple (etc.) under User & Authentication → Social Connections.
# After OAuth, /api/auth/clerk/bridge mints the app o2b_session so requireRole keeps working.
# Authorized redirect: handled by Clerk; also add your site URL in Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional overrides (defaults work with /[lang]/login/* routes):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/login

# OTP delivery. Without one of these, development prints codes to the terminal
# and production answers /api/auth/request-otp with 503 and an honest message,
# rather than accepting the request and delivering nothing.
#
# `GET /api/health` reports which channels are live, so this is monitorable:
#   "otpDelivery": ["email"]   ← working
#   "otpDelivery": ["none"]    ← nobody can sign in
RESEND_API_KEY=
EMAIL_FROM=
SPRINGEDGE_API_KEY=
SPRINGEDGE_SENDER_ID=

# --- contact details ---
# Public by nature: these are rendered into the page, so NEXT_PUBLIC_ is right.
#
# Enquiries are written to Postgres first and these are a convenience on top —
# but until they are set, the WhatsApp and email buttons do not render at all,
# because a button that opens a chat with nobody is worse than no button.
#
# Digits only, no '+', country code included. The old hardcoded placeholder
# (6281200000000) is rejected explicitly, so pasting it back does nothing.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- payments ---
# Razorpay is the INR checkout path. Setting KEY_ID makes /api/health report
# payments configured; KEY_SECRET is required for Checkout.js verify;
# WEBHOOK_SECRET is required for POST /api/payments/webhook (payment.captured).
# Without secrets, checkout can still create orders but capture will 503.
#   "payments": { "provider": "razorpay", "configured": true }
#   "payments": { "provider": null, "configured": false }
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional alternate providers (not wired for traveller checkout UI yet).
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- uploads (provider media + KYC) ---
# Production: set BLOB_READ_WRITE_TOKEN from Vercel Blob.
# Local/dev without the token writes under public/uploads/ (gitignored).
# GET /api/health reports "uploads": "vercel_blob" | "local" | "none".
BLOB_READ_WRITE_TOKEN=

# --- application ---
# Server-side only. Must never reach the browser.
GEMINI_API_KEY=
