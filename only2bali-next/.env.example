# Copy to .env.local for development. Never commit the filled-in version.

# --- database ---
# Production is Neon (Vercel integration). Server TLS only, sslmode=require.
# The Vercel Neon integration also writes o2b_DATABASE_URL; the app reads
# DATABASE_URL first, then that alias.
#   postgres://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Local Docker: postgres://only2bali:PASSWORD@127.0.0.1:5432/only2bali
DATABASE_URL=

# Optional. Local Docker stays unencrypted unless this is "require".
DATABASE_SSL=

# Serverless keeps many short-lived instances, so pools stay small.
DATABASE_POOL_MAX=

# --- auth ---
# Keys the OTP and session hashes. Rotating it invalidates every outstanding
# code and session, which is the intended emergency lever.
#   openssl rand -base64 48
AUTH_SECRET=

# Username/password admin bootstrap. Never expose admin registration publicly.
# Run after setting these:
#   npm run admin:create
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Google OAuth for traveler/provider login (legacy; prefer Clerk when configured).
# Authorized redirect URI:
#   https://YOUR_DOMAIN/api/auth/google/callback
# Local redirect URI:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Clerk OAuth (recommended) ---
# Create an application at https://dashboard.clerk.com
# Enable Google / Apple (etc.) under User & Authentication → Social Connections.
# After OAuth, /api/auth/clerk/bridge mints the app o2b_session so requireRole keeps working.
# Authorized redirect: handled by Clerk; also add your site URL in Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional overrides (defaults work with /[lang]/login/* routes):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/login

# OTP delivery. Without one of these, development prints codes to the terminal
# and production answers /api/auth/request-otp with 503 and an honest message,
# rather than accepting the request and delivering nothing.
#
# `GET /api/health` reports which channels are live, so this is monitorable:
#   "otpDelivery": ["email"]   ← working
#   "otpDelivery": ["none"]    ← nobody can sign in
RESEND_API_KEY=
EMAIL_FROM=
SPRINGEDGE_API_KEY=
SPRINGEDGE_SENDER_ID=

# --- contact details ---
# Public by nature: these are rendered into the page, so NEXT_PUBLIC_ is right.
#
# Enquiries are written to Postgres first and these are a convenience on top —
# but until they are set, the WhatsApp and email buttons do not render at all,
# because a button that opens a chat with nobody is worse than no button.
#
# Digits only, no '+', country code included. The old hardcoded placeholder
# (6281200000000) is rejected explicitly, so pasting it back does nothing.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Sending the sign-in code ---------------------------------------------
# Either path works. Set one; the app reports which in /api/health.
#
# A) Resend's own API. Free: 3,000/month.
RESEND_API_KEY=
#
# B) Any SMTP provider, which is most of them. Free tiers that cover a launch:
#      Brevo       300/day forever   smtp-relay.brevo.com   587
#      Zoho Mail   free custom domain smtp.zoho.in          465
#      Gmail       ~500/day           smtp.gmail.com        465  (app password,
#                                                                not your login)
#      Mailtrap    1,000/month        live.smtp.mailtrap.io 587
# Port 465 means implicit TLS, 587 means STARTTLS; the app derives that.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be an address the provider has let you send from, or mail is dropped
# silently at send time rather than rejected at deploy time.
EMAIL_FROM=

# --- Storing uploads -------------------------------------------------------
# Either Vercel Blob (above) or any S3-compatible store. Free tiers:
#   Cloudflare R2   10 GB, no egress fee   https://<acct>.r2.cloudflarestorage.com
#   Backblaze B2    10 GB                  https://s3.<region>.backblazeb2.com
#
# Two buckets, not one. Public media and private KYC documents are kept apart
# so a guessable photo URL can never reach somebody's passport scan.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=
S3_BUCKET_DOCUMENTS=
# The public domain for the media bucket only. Without it, uploaded photos
# would have no URL a browser could read, so media uploads refuse instead.
S3_PUBLIC_BASE_URL=

# --- payments ---
# Razorpay is the INR checkout path. KEY_ID and KEY_SECRET are the API pair.
# WEBHOOK_SECRET is a separate 32+ character value you choose in the Razorpay
# dashboard; it is not the API secret and it is not a URL. Live checkout stays
# safely paused until all three are present. Configure the dashboard webhook URL:
#   https://YOUR_DOMAIN/api/payments/webhook
# and subscribe to payment.captured, payment.authorized and payment.failed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-dashboard-webhook-secret
# Stripe is the second traveller checkout option (cards). All three required
# before Stripe is marked available. Webhook URL:
#   https://YOUR_DOMAIN/api/payments/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional alternate providers (not shown on traveller checkout).
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=

# --- uploads (provider media + KYC) ---
# Production requires TWO separate Vercel Blob stores because a store's access
# level cannot be changed later. Marketplace photos use a public store. Identity
# and KYC documents use a private store and are streamed only after server-side
# role checks. Never reuse the public token for documents.
# Local/dev without tokens writes media under public/uploads/ and documents
# under private .uploads/ (both gitignored).
# GET /api/health reports each backend independently.
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Bearer token for POST /api/ops/migrate and POST /api/ops/bootstrap-admin
# (32+ chars). Leave empty so both routes stay 503.
MIGRATE_TOKEN=

# --- application ---
# Server-side only. Must never reach the browser.
GEMINI_API_KEY=
