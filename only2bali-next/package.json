    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
