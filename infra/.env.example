# Copy to infra/.env on the VPS. chmod 600. Never commit the filled-in file.

# --- database ---
# The role name MUST match the CN in the client certificate (only2bali_app),
# or pg_hba.conf's clientcert=verify-full rejects the connection.
POSTGRES_USER=only2bali_app
# Generate on the server: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
POSTGRES_PASSWORD=
POSTGRES_DB=only2bali

# Non-default port. Not security by itself, but it removes most of the
# background scanning noise from the logs.
POSTGRES_PORT=5432

BACKUP_RETENTION_DAYS=14
