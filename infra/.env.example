# Copy to infra/.env on the VPS. chmod 600. Never commit the filled-in file.

# --- domain and TLS ---
# Point an A record at the VPS before starting Caddy, or certificate issuance
# will fail and Let's Encrypt will rate-limit you.
SITE_DOMAIN=only2bali.com
ACME_EMAIL=you@example.com

# --- database ---
# Generate on the server:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
POSTGRES_USER=only2bali
POSTGRES_PASSWORD=
POSTGRES_DB=only2bali
BACKUP_RETENTION_DAYS=14

# --- application ---
# Server-side only. Never exposed to the browser.
GEMINI_API_KEY=
